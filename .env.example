# DATABASE_URL=mysql+pymysql://user:password@host:3308/blog?charset=utf8mb4
DB_CONNECT_RETRIES=30
DB_CONNECT_INTERVAL=2
# 不再由本项目创建 MySQL，保留原 root 密码配置作为历史参考。
# MYSQL_ROOT_PASSWORD=please_change_root_password
ADMIN_USERNAME=baize
ADMIN_PASSWORD=please_change_admin_password
AUTH_SECRET=please_generate_a_long_random_secret
